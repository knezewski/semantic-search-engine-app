# ---------------------------------------------------------------------------
# Local development environment (bun run dev / dev:worker)
#
# Bun auto-loads this file because NODE_ENV defaults to "development".
# Precedence (highest last): .env -> .env.development -> .env.local -> .env.development.local
# Put personal secrets in .env.development.local (gitignored), never here.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Redis (BullMQ queue)
REDIS_URL=redis://localhost:6379

# SQLite document store (local file)
SQLITE_PATH=./data/semantic-search.sqlite

# Qdrant (local Docker)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=document_chunks
VECTOR_SIZE=384

# Embedding / chunking
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_CACHE_SIZE=256

# Rerank
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20

# Search
SEARCH_HNSW_EF=64
