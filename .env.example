# HTTP
PORT=3000
LOG_LEVEL=info

# Redis (BullMQ queue)
REDIS_URL=redis://localhost:6379

# SQLite document store
SQLITE_PATH=./data/semantic-search.sqlite

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=document_chunks
VECTOR_SIZE=384

# Embedding / chunking
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Pin to an immutable Hugging Face commit SHA for repeatable model + tokenizer loading.
# EMBEDDING_REVISION=<40-character-commit-sha>
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_CACHE_SIZE=256

# Rerank
RERANK_ENABLED=false
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RERANK_REVISION=<40-character-commit-sha>
RERANK_CANDIDATES=15

# Search
SEARCH_HNSW_EF=64

# Evaluation (writes eval-runs/<unique-run-id>/; never overwrites old reports)
EVAL_FIXTURE_SET=smoke
EVAL_SEED=42
EVAL_QUERIES=0
EVAL_BOOTSTRAP_RESAMPLES=2000
EVAL_LATENCY_QUERIES=100
# Independent scoring: fixed top-50 prefixes, or retrieval at each pool's own depth.
EVAL_POOL_PROTOCOL=fixed-candidates
# Warmups are excluded; each measured query/pool is repeated serially.
EVAL_LATENCY_REPEATS=3
EVAL_LATENCY_WARMUP_ROUNDS=1
# Model sweep: pin each repository separately; one model's SHA is not valid for another.
# EVAL_MODEL_REVISIONS={"BAAI/bge-small-en-v1.5":"<sha>","Xenova/all-MiniLM-L6-v2":"<sha>"}
