              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 202 Accepted\", function () {",
                  "  pm.response.to.have.status(202);",
                  "});",
                  "pm.test(\"returns an id and queued status\", function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body.id).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(body.status).to.eql(\"queued\");",
                  "  pm.collectionVariables.set(\"documentId\", body.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"JWT authentication\",\n  \"text\": \"JWT authentication allows a server to issue a signed token after login. The client sends the token on later requests. The server verifies the signature instead of storing session state. Expired tokens must be rejected.\",\n  \"source\": \"docs/auth.md\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/documents", "host": ["{{baseUrl}}"], "path": ["documents"] }
          },
          "response": []
        },
        {
          "name": "Get Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"never exposes the raw text\", function () {",
                  "  pm.expect(pm.response.json()).to.not.have.property(\"text\");",
                  "});",
                  "pm.test(\"status is a known pipeline state\", function () {",
                  "  var allowed = [\"queued\", \"chunking\", \"embedding\", \"indexing\", \"ready\", \"failed\"];",
                  "  pm.expect(allowed).to.include(pm.response.json().status);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/documents/{{documentId}}", "host": ["{{baseUrl}}"], "path": ["documents", "{{documentId}}"] }
          },
          "response": []
        },
        {
          "name": "Poll Until Ready",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Re-send this request until status becomes ready.",
                  "pm.test(\"document finishes processing\", function () {",
                  "  pm.expect([\"ready\", \"failed\"]).to.include(pm.response.json().status);",
                  "});",
                  "pm.test(\"document is ready (not failed)\", function () {",
