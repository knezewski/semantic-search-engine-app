    {
      "name": "02 - Search",
      "item": [
        {
          "name": "Search - Default (rerank)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"returns at most limit results\", function () {",
                  "  pm.expect(pm.response.json().results.length).to.be.at.most(5);",
                  "});",
                  "pm.test(\"result shape is complete\", function () {",
                  "  var first = pm.response.json().results[0];",
                  "  pm.expect(first).to.have.property(\"chunkId\");",
                  "  pm.expect(first).to.have.property(\"documentId\");",
                  "  pm.expect(first).to.have.property(\"text\");",
                  "  pm.expect(first).to.have.property(\"score\");",
                  "  pm.expect(first).to.have.property(\"position\");",
                  "});",
                  "pm.test(\"top result is the JWT document\", function () {",
                  "  pm.expect(pm.response.json().results[0].source).to.eql(\"docs/auth.md\");",
                  "});",
                  "pm.test(\"exposes Server-Timing header\", function () {",
                  "  pm.expect(pm.response.headers.get(\"Server-Timing\")).to.include(\"total\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"How does JWT authentication work?\",\n  \"limit\": 5\n}",
