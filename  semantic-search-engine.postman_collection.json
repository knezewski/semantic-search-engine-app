    {
      "name": "00 - Infrastructure",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"status is ok\", function () {",
                  "  pm.expect(pm.response.json().status).to.eql(\"ok\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "response": []
        },
        {
          "name": "Ready",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 200 when dependencies are up\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"qdrant and redis are reachable\", function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body.qdrant).to.eql(true);",
                  "  pm.expect(body.redis).to.eql(true);",
                  "});",
                  "pm.test(\"reports collection name\", function () {",
                  "  pm.expect(pm.response.json().collection).to.eql(\"document_chunks\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/ready", "host": ["{{baseUrl}}"], "path": ["ready"] }
          },
          "response": []
        },
        {
          "name": "Metrics",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"exposes the four pipeline queues\", function () {",
                  "  var names = pm.response.json().queues.map(function (q) { return q.name; });",
                  "  pm.expect(names).to.include(\"document-ingest\");",
                  "  pm.expect(names).to.include(\"chunk-generation\");",
                  "  pm.expect(names).to.include(\"embedding-generation\");",
                  "  pm.expect(names).to.include(\"vector-indexing\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/metrics", "host": ["{{baseUrl}}"], "path": ["metrics"] }
          },
          "response": []
        }
      ]
    },
