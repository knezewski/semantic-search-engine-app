# ---------------------------------------------------------------------------
# Production environment (NODE_ENV=production bun src/index.ts / workers)
#
# Loaded by Bun only when NODE_ENV=production (set by `bun run start`/`worker`
# or by the deployment environment). Precedence (highest last):
#   .env -> .env.production -> .env.local -> .env.production.local
# NEVER commit secrets here — put them in .env.production.local (gitignored)
# or inject them via your secret manager / container orchestrator.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Redis (BullMQ queue)
# Use your managed Redis URL or the in-cluster service name, e.g. redis://redis:6379
REDIS_URL=redis://redis:6379

# SQLite document store — point at a persistent volume in production
SQLITE_PATH=/data/semantic-search.sqlite

# Qdrant
# Managed Qdrant Cloud: use https://<cluster>.qdrant.io and set QDRANT_API_KEY.
# Self-hosted inside the cluster: use http://qdrant:6333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
COLLECTION_NAME=document_chunks
VECTOR_SIZE=384

# Embedding / chunking
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_CACHE_SIZE=1024

# Rerank
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20

# Search — higher ef improves recall at the cost of latency
SEARCH_HNSW_EF=128
